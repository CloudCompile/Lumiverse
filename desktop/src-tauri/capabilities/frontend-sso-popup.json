{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "frontend-sso-popup",
  "description": "Allows a native frontend sign-in popup to close itself after authentication.",
  "local": false,
  "windows": ["frontend-popup-*"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "http://*",
      "https://*"
    ]
  },
  "permissions": ["desktop-sso-popup-close"]
}
