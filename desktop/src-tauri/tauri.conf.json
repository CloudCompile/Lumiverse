{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumiverse Desktop",
  "version": "0.3.0",
  "identifier": "chat.lumiverse.tray",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumiverse",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 0,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling",
        "skipTaskbar": true,
        "alwaysOnBottom": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "license": "LicenseRef-LCL-2.1",
    "licenseFile": "../../LICENSE.md",
    "resources": {
      "../../LICENSE.md": "LICENSE.md"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "shortDescription": "Experimental Lumiverse integrated browser and tray",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
