<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Public ProMotion opt-in. WebKit's private override is a separate build feature. -->
  <key>CADisableMinimumFrameDurationOnPhone</key><true/>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <!-- Tao's iOS scene delegate is enabled by this boolean. -->
    <key>UIApplicationSupportsMultipleScenes</key><true/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key><string>TaoScene</string>
          <key>UISceneClassName</key><string>UIWindowScene</string>
          <key>UISceneDelegateClassName</key><string>TaoSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <key>NSCameraUsageDescription</key>
  <string>Attach a photo to your Lumiverse conversation.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Use your microphone to dictate and record audio for your Lumiverse conversation.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Transcribe your voice into messages using Apple's speech recognition service.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Connect to your Lumiverse server on your local network.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key><true/>
  </dict>
</dict>
</plist>
