{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumiverse",
  "version": "0.3.1",
  "identifier": "chat.lumiverse.ios",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "label": "main", "title": "Lumiverse", "url": "index.html" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "icon": ["../../../frontend/public/icon-512.png"],
    "iOS": { "minimumSystemVersion": "15.0", "infoPlist": "Info.ios.plist" }
  }
}
