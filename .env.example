# Server (used by local launches and Docker Compose)
# Change this to any available port from 1 through 65535.
PORT=7860

# ─── Credentials ─────────────────────────────────────────────────────────
# Owner password is stored hashed in data/owner.credentials (created by
# the setup wizard). No plaintext passwords in this file!
#
# To reset the owner password: bun run reset-password
#
# OWNER_USERNAME is only used as the display name for the owner account.
# The actual username is stored in data/owner.credentials.
# OWNER_USERNAME=admin

# ─── Encryption ──────────────────────────────────────────────────────────
# Handled by data/lumiverse.identity (auto-generated on first run).
# If migrating from an older version, set ENCRYPTION_KEY here and it will
# be migrated to the identity file automatically on next startup.
# ENCRYPTION_KEY=

# Optional: authentication secret (32-byte hex string)
# If omitted, automatically derived from data/lumiverse.identity.
# AUTH_SECRET=

# Optional: pin Better Auth and OAuth to one public origin. Normally Lumiverse
# derives the origin from the request after it matches Trusted Hostnames.
# AUTH_BASE_URL=https://app.example.com

# ─── Direct TLS / custom certificates ─────────────────────────────────
# Leave these unset when TLS terminates at a reverse proxy (the usual setup).
# Setting the pair below makes Lumiverse's Bun listener HTTPS-only with HTTP/2
# and HTTP/1.1 negotiated on the same port. The PEM certificate may be a full
# chain and may contain any number of DNS SANs.
# LUMIVERSE_TLS_CERT_FILE=/etc/lumiverse/tls/fullchain.pem
# LUMIVERSE_TLS_KEY_FILE=/etc/lumiverse/tls/privkey.pem
# For an encrypted private key, put only its passphrase in a separate file:
# LUMIVERSE_TLS_KEY_PASSPHRASE_FILE=/run/secrets/lumiverse-tls-passphrase
#
# To select different certificates by SNI, use the JSON manifest documented in
# user-docs/docs/getting-started/installation.md instead of the three settings
# above. Relative certificate paths are resolved from the manifest directory.
# LUMIVERSE_TLS_CONFIG_FILE=/etc/lumiverse/tls/certificates.json

# ─── Legacy migration ───────────────────────────────────────────────────
# If you have OWNER_PASSWORD in your .env from a previous version, the
# server will automatically migrate it to data/owner.credentials on next
# startup. You can then remove OWNER_PASSWORD from this file.
# OWNER_PASSWORD=

# ─── Optional ────────────────────────────────────────────────────────────

# Path to built frontend (e.g., ../LumiverseFrontend/dist)
# When set, the backend serves the frontend as static files.
# FRONTEND_DIR=

# Comma-separated trusted origins for CORS
# Leave unset to allow all origins (development), or set for production:
# TRUSTED_ORIGINS=http://localhost:5173,http://localhost:7860

# Reverse proxies (IPs or CIDRs) allowed to supply the external host/protocol
# and real client IP via forwarded headers. Host/protocol are accepted only
# from this explicit list; client-IP headers retain the legacy private-peer
# fallback when this is unset. Configure the headers your proxy actually sets:
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-Host $host;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Real-IP $remote_addr;
# TRUSTED_PROXIES=203.0.113.10,10.0.0.0/8

# ─── Runtime memory mode ─────────────────────────────────────────────────
# Bun's "smol" mode uses less RAM but runs garbage collection more often
# (slightly slower). It defaults to ON, which keeps low-memory / Android
# (Termux) installs healthy. On a machine with plenty of RAM you can disable
# it for a small speedup. Setting it here (rather than editing bunfig.toml)
# means your choice survives auto-updates.
# Accepts false/0/off/no to disable; anything else (or unset) keeps it on.
# LUMIVERSE_SMOL=false

# Prompt assembly workers retain tokenizer/count caches between generations.
# Idle timeout defaults to 10 minutes; allowed range is 30 seconds to 30 minutes.
# Memory-pressure notifications can still release idle workers sooner.
# LUMIVERSE_PROMPT_ASSEMBLY_IDLE_MS=600000
# LUMIVERSE_PROMPT_ASSEMBLY_WORKERS=2
# LUMIVERSE_PROMPT_ASSEMBLY_WORKER=false

# Emergency theme recovery. When enabled, Lumiverse starts with saved custom
# CSS and component CSS/TSX overrides suppressed without deleting them.
# Remove the flag and restart to restore the saved styling.
# LUMIVERSE_SAFE_THEME=true

# LanceDB maintenance runs in a child process five seconds after the server is
# ready, so compaction cannot monopolize the serving runtime. It is enabled by
# default; disable it only when maintenance will be scheduled manually.
# LUMIVERSE_LANCEDB_STARTUP_MAINTENANCE=false

# Disk pressure warnings
# The backend warns only when BOTH conditions are true:
#   1) disk usage is at/above LUMIVERSE_DISK_WARNING_USAGE_PERCENT
#   2) free space is at/below LUMIVERSE_DISK_WARNING_MIN_FREE_BYTES
# This avoids noisy warnings on very large disks that are mostly full but still
# have plenty of usable headroom left. These act as the startup defaults until
# the server owner saves an override from the Operator panel.
# LUMIVERSE_DISK_WARNING_USAGE_PERCENT=90
# LUMIVERSE_DISK_WARNING_MIN_FREE_BYTES=107374182400

# Optional SMART disk health monitoring (smartmontools/smartctl)
# The setup wizard installs smartmontools by default when a supported package
# manager is available. Docker images include it, but containers also need
# explicit host block-device access (see docker-compose.yml).
# LUMIVERSE_SMARTCTL_PATH=
# LUMIVERSE_SMART_MONITOR=false
# For unattended root/container provisioning only: attempts a fixed package
# manager install at startup; never runs sudo or prompts for credentials.
# LUMIVERSE_SMARTCTL_AUTO_INSTALL=true

# Spindle ephemeral storage pools
SPINDLE_EPHEMERAL_GLOBAL_MAX_BYTES=524288000
SPINDLE_EPHEMERAL_EXTENSION_DEFAULT_MAX_BYTES=52428800
SPINDLE_EPHEMERAL_EXTENSION_MAX_OVERRIDES=
SPINDLE_EPHEMERAL_RESERVATION_TTL_MS=600000

# ─── SillyTavern migrator: remote SFTP source (opt-in) ──────────────────
# Disabled by default. The ssh2 package ships a native addon (sshcrypto.node)
# that calls libuv functions Bun does not implement on POSIX, so loading it
# triggers an uncatchable process crash (panic: unsupported uv function:
# uv_version_string) — which is why the ST Migrator would die on open when
# it probed SFTP availability. See oven-sh/bun#18546, #11947, #8228.
#
# Set to 1 only if you know your runtime can load ssh2 cleanly (e.g. a Bun
# build that has shipped the uv polyfills, or Node). Local, SMB, Google
# Drive and Dropbox migrator sources are unaffected.
# LUMIVERSE_ENABLE_SFTP=1
